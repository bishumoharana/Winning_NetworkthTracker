{
  "name": "winning-network-tracker",
  "version": "1.0.0",
  "description": "A desktop application to monitor network adapters, real-time usage, and data trends.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"webpack --watch\" \"electron .\"",
    "build": "webpack && electron-builder",
    "test": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": ["electron", "network", "monitor", "tracker"],
  "author": "bishumoharana",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "ts-loader": "^9.0.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "better-sqlite3": "^9.0.0",
    "recharts": "^2.0.0",
    "os-utils": "^0.0.14"
  },
  "build": {
    "appId": "com.bishumoharana.networktracker",
    "productName": "Network Tracker",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
