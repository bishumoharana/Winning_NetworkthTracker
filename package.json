{
  "name": "winning-network-tracker",
  "version": "1.0.0",
  "description": "A desktop application to monitor network adapters, real-time usage, and data trends.",
  "main": "build/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on build/renderer/index.html && electron .\"",
    "watch:main": "webpack --watch --config webpack.main.config.js",
    "watch:renderer": "webpack --watch --config webpack.renderer.config.js",
    "build:main": "webpack --config webpack.main.config.js",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder",
    "test": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0"
  },
  "keywords": ["electron", "network", "monitor", "tracker"],
  "author": "bishumoharana",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "better-sqlite3": "^9.5.0",
    "os-utils": "^0.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.4"
  },
  "build": {
    "appId": "com.bishumoharana.networktracker",
    "productName": "Network Tracker",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
